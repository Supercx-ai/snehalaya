# Your deployed site URL (no trailing slash) — used in structured data (JSON-LD) and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your store domain, e.g. my-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Admin > Apps > Develop apps > Storefront API)
SHOPIFY_STOREFRONT_TOKEN=
# Webhook signing secret (Admin > Notifications/Webhooks). Used to verify /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=

# WhatsApp CTA — phone number in international format, no + or spaces, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Judge.me reviews (Settings > Integrations > Judge.me API)
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN=
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=

# Instagram Graph API long-lived access token
INSTAGRAM_ACCESS_TOKEN=
# Handle shown in the "Follow on Instagram" link — defaults to snehalayaasilks if unset
NEXT_PUBLIC_INSTAGRAM_HANDLE=snehalayaasilks

# Pick any random string — required to use the "Clear cache" button at /admin.
CACHE_CLEAR_SECRET=123

# Customer login/order history — Admin → Settings → Customer accounts → switch to
# "New customer accounts" → create a Customer Account API client (public client, no
# secret). Redirect URI to register: <NEXT_PUBLIC_SITE_URL>/api/auth/callback
SHOPIFY_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# Numeric shop id (NOT the myshopify.com domain) — shown on that same setup screen.
SHOPIFY_SHOP_ID=

# Google Analytics 4 Measurement ID (Admin → GA4 property → Data Streams → your web
# stream → "G-XXXXXXX"). Tracks page views, view_item, add_to_cart, begin_checkout.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Image search (Google Cloud Vision Product Search) — interim while Syte/Vue.ai
# headless API access is confirmed. Needs a GCP project with Vision API + Cloud
# Storage API enabled, billing on, a service account (Vision + Storage Object Admin
# roles), and a bucket. Location must be one of: us-west1, us-east1, europe-west1,
# asia-east1 (Product Search's fixed list — asia-east1 recommended for India).
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=asia-east1
GOOGLE_CLOUD_STORAGE_BUCKET=
# The downloaded service-account JSON key file, base64-encoded into one line:
# (macOS/Linux: base64 -i key.json | tr -d '\n'   |   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")))
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
