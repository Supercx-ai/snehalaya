# Your deployed site URL (no trailing slash) — used in structured data (JSON-LD) and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your store domain, e.g. my-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (Admin > Apps > Develop apps > Storefront API)
SHOPIFY_STOREFRONT_TOKEN=
# Webhook signing secret (Admin > Notifications/Webhooks). Used to verify /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=

# WhatsApp CTA — phone number in international format, no + or spaces, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Judge.me reviews (Settings > Integrations > Judge.me API)
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN=
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=

# Instagram Graph API long-lived access token
INSTAGRAM_ACCESS_TOKEN=

# Pick any random string — required to use the "Clear cache" button at /admin.
CACHE_CLEAR_SECRET=123
